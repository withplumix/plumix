{
  "name": "create-plumix-app",
  "version": "0.9.0",
  "type": "module",
  "description": "Scaffold a new Plumix site.",
  "license": "MIT",
  "author": "Plumix Contributors",
  "homepage": "https://docs.plumix.dev/getting-started/installation/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withplumix/plumix.git",
    "directory": "packages/create-plumix-app"
  },
  "bugs": {
    "url": "https://github.com/withplumix/plumix/issues"
  },
  "keywords": [
    "create",
    "scaffold",
    "plumix",
    "cms"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "create-plumix-app": "./dist/index.js"
  },
  "files": [
    "dist",
    "base",
    "registry.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "jsonc-parser": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && plumix-check-declarations",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint",
    "prepack": "tsc -p tsconfig.build.json && node scripts/build-snapshot.mjs",
    "publint": "publint",
    "smoke:scaffold": "node scripts/smoke.mjs",
    "test:unit": "vitest run",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@plumix/admin": "workspace:*",
    "@plumix/admin-editor": "workspace:*",
    "@plumix/admin-ui": "workspace:*",
    "@plumix/core": "workspace:*",
    "@plumix/eslint-config": "workspace:*",
    "@plumix/plugin-audit-log": "workspace:*",
    "@plumix/plugin-blog": "workspace:*",
    "@plumix/plugin-comments": "workspace:*",
    "@plumix/plugin-feeds": "workspace:*",
    "@plumix/plugin-forms": "workspace:*",
    "@plumix/plugin-media": "workspace:*",
    "@plumix/plugin-menu": "workspace:*",
    "@plumix/plugin-og": "workspace:*",
    "@plumix/plugin-pages": "workspace:*",
    "@plumix/plugin-search": "workspace:*",
    "@plumix/plugin-seo": "workspace:*",
    "@plumix/prettier-config": "workspace:*",
    "@plumix/runtime-bun": "workspace:*",
    "@plumix/runtime-cloudflare": "workspace:*",
    "@plumix/runtime-node": "workspace:*",
    "@plumix/typescript-config": "workspace:*",
    "@plumix/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:vitest",
    "eslint": "catalog:",
    "plumix": "workspace:*",
    "prettier": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:vitest"
  },
  "prettier": "@plumix/prettier-config"
}
