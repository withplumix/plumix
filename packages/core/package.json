{
  "name": "@plumix/core",
  "version": "0.23.0",
  "type": "module",
  "description": "Plumix core: runtime, auth, data model, and plugin system",
  "license": "MIT",
  "author": "Plumix Contributors",
  "homepage": "https://github.com/withplumix/plumix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withplumix/plumix.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/withplumix/plumix/issues"
  },
  "keywords": [
    "plumix",
    "cms",
    "framework"
  ],
  "//sideEffects": "Everything is pure except the island runtime, which calls registerIslandElement() at module load and is imported purely for that side effect (import \"@plumix/core/blocks/island-runtime\"). Marking the rest side-effect-free lets bundlers drop unused barrel re-exports — notably the Tiptap mark/node schemas (unknownBlockSchema, coreMarkExtensions) so ProseMirror tree-shakes out of consumers that only use coreBlocks/render.",
  "sideEffects": [
    "**/blocks/island-runtime.js"
  ],
  "//browser": "Browser-only sanitizer swap. The editor + islands run in the DOM, where sanitize-html's bundled HTML parser + entity tables + postcss (~230 KB) are redundant; bundlers building for the browser remap it to the DOMPurify shim (~45 KB, native DOMParser). The worker/SSR build is DOM-less and keeps the real sanitize-html.",
  "browser": {
    "sanitize-html": "./dist/blocks/html/dompurify-shim.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./auth": {
      "types": "./dist/auth/config.d.ts",
      "default": "./dist/auth/config.js"
    },
    "./blocks": {
      "types": "./dist/blocks/index.d.ts",
      "default": "./dist/blocks/index.js"
    },
    "./blocks/renderer": {
      "types": "./dist/blocks/renderer/index.d.ts",
      "default": "./dist/blocks/renderer/index.js"
    },
    "./blocks/test": {
      "types": "./dist/blocks/test/index.d.ts",
      "default": "./dist/blocks/test/index.js"
    },
    "./blocks/island-events": {
      "types": "./dist/blocks/island-events.d.ts",
      "default": "./dist/blocks/island-events.js"
    },
    "./blocks/island-runtime": {
      "types": "./dist/blocks/island-runtime.d.ts",
      "default": "./dist/blocks/island-runtime.js"
    },
    "./blocks/island-renderer": {
      "types": "./dist/blocks/island-renderer.d.ts",
      "default": "./dist/blocks/island-renderer.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./schema": {
      "types": "./dist/db/schema/index.d.ts",
      "default": "./dist/db/schema/index.js"
    },
    "./db": {
      "types": "./dist/db/public.d.ts",
      "default": "./dist/db/public.js"
    },
    "./db/libsql": {
      "types": "./dist/db/libsql.d.ts",
      "default": "./dist/db/libsql.js"
    },
    "./cdn/cloudflare": {
      "types": "./dist/cdn/cloudflare/index.d.ts",
      "default": "./dist/cdn/cloudflare/index.js"
    },
    "./storage/s3": {
      "types": "./dist/storage/s3/index.d.ts",
      "default": "./dist/storage/s3/index.js"
    },
    "./dev-client": {
      "types": "./dist/dev-client/index.d.ts",
      "default": "./dist/dev-client/index.js"
    },
    "./test": {
      "types": "./dist/test/index.d.ts",
      "default": "./dist/test/index.js"
    },
    "./test/browser": {
      "types": "./dist/test/browser.d.ts",
      "default": "./dist/test/browser.js"
    },
    "./test/playwright": {
      "types": "./dist/test/playwright/index.d.ts",
      "default": "./dist/test/playwright/index.js"
    },
    "./test/conformance": {
      "types": "./dist/test/conformance/index.d.ts",
      "default": "./dist/test/conformance/index.js"
    },
    "./validation": {
      "types": "./dist/rpc/validation.d.ts",
      "default": "./dist/rpc/validation.js"
    },
    "./manifest": {
      "types": "./dist/plugin/manifest.d.ts",
      "default": "./dist/plugin/manifest.js"
    },
    "./fields": {
      "types": "./dist/plugin/fields/index.d.ts",
      "default": "./dist/plugin/fields/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "default": "./dist/i18n/index.js"
    },
    "./i18n-compile": {
      "types": "./i18n-compile/index.d.mts",
      "default": "./i18n-compile/index.mjs"
    },
    "./locales/*": {
      "types": "./locales/*.d.mts",
      "default": "./locales/*.mjs"
    },
    "./slugify": {
      "types": "./dist/slugify.d.ts",
      "default": "./dist/slugify.js"
    },
    "./support": {
      "types": "./dist/support.d.ts",
      "default": "./dist/support.js"
    },
    "./telemetry-otel": {
      "types": "./dist/telemetry-otel.d.ts",
      "default": "./dist/telemetry-otel.js"
    }
  },
  "bin": {
    "plumix-compile-catalogs": "./bin/plumix-compile-catalogs.mjs"
  },
  "files": [
    "bin",
    "dist",
    "i18n-compile",
    "locales",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "attw": "attw --pack . --profile esm-only",
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .drizzle .turbo dist node_modules",
    "db:generate": "drizzle-kit generate",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "i18n:check": "node ../plumix/bin/plumix.mjs i18n verify --src src/admin-bar --src src/welcome --src src/blocks",
    "i18n:compile": "node bin/plumix-compile-catalogs.mjs --dts",
    "lint": "eslint",
    "publint": "publint",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@libsql/client": "catalog:",
    "@lingui/core": "catalog:lingui",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@orpc/client": "catalog:orpc",
    "@orpc/openapi": "catalog:orpc",
    "@orpc/server": "catalog:orpc",
    "@orpc/standard-server-fetch": "catalog:orpc",
    "@orpc/valibot": "catalog:orpc",
    "@oslojs/crypto": "catalog:oslojs",
    "@oslojs/encoding": "catalog:oslojs",
    "@oslojs/webauthn": "catalog:oslojs",
    "@sindresorhus/slugify": "^3.0.0",
    "@tiptap/core": "catalog:tiptap",
    "@valibot/to-json-schema": "^1.7.1",
    "dompurify": "^3.4.14",
    "drizzle-kit": "catalog:drizzle",
    "drizzle-orm": "catalog:drizzle",
    "drizzle-valibot": "catalog:drizzle",
    "fishery": "catalog:",
    "highlight.js": "^11.12.0",
    "sanitize-html": "^2.17.7",
    "valibot": "catalog:"
  },
  "peerDependencies": {
    "@playwright/test": "catalog:",
    "esbuild": "catalog:",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "vitest": "catalog:vitest"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@lingui/cli": "catalog:lingui",
    "@playwright/test": "catalog:",
    "@plumix/eslint-config": "workspace:*",
    "@plumix/lingui-config": "workspace:*",
    "@plumix/prettier-config": "workspace:*",
    "@plumix/typescript-config": "workspace:*",
    "@plumix/vitest-config": "workspace:*",
    "@testing-library/react": "catalog:testing-library",
    "@types/node": "catalog:",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/browser-playwright": "catalog:vitest",
    "@vitest/coverage-v8": "catalog:vitest",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "publint": "catalog:",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "typescript": "catalog:",
    "vitest": "catalog:vitest"
  },
  "prettier": "@plumix/prettier-config"
}
