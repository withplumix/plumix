{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "stripInternal": true,
    "tsBuildInfoFile": "${configDir}/.cache/build.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/storage/s3/fake-s3.ts",
    "src/test/import-graph.ts",
    "src/test/playwright/playground-fixture.ts"
  ]
}
