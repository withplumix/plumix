{
  "extends": "@plumix/typescript-config/base.json",
  "compilerOptions": {
    "types": ["node", "@cloudflare/workers-types"],
    "jsx": "react-jsx",
    // The islands are browser code.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // Resolve workspace packages from `src/` (not `dist/`) so the playground
    // typechecks against live source.
    "paths": {
      "plumix": ["../../plumix/src/index.ts"],
      "plumix/auth": ["../../plumix/src/auth/index.ts"],
      "plumix/blocks": ["../../plumix/src/blocks/index.ts"],
      "plumix/blocks/renderer": ["../../plumix/src/blocks/renderer.ts"],
      "plumix/plugin": ["../../plumix/src/plugin.ts"],
      "plumix/theme": ["../../plumix/src/theme/index.ts"],
      "@plumix/plugin-media": ["../../plugins/media/src/index.ts"],
      "@plumix/runtime-cloudflare": ["../../runtimes/cloudflare/src/index.ts"]
    }
  },
  "include": ["plumix.config.ts", "theme.ts", "blocks", "islands", ".plumix"]
}
