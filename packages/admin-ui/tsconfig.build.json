{
  "extends": [
    "./tsconfig.json",
    "@plumix/typescript-config/library.build.json"
  ],
  "compilerOptions": {
    "stripInternal": true,
    // The wide tsconfig.json adds node types for the roster script; the
    // published source stays free of them.
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
