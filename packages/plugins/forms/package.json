{
  "name": "@plumix/plugin-forms",
  "version": "0.0.0",
  "type": "module",
  "description": "Forms plugin for Plumix \u2014 forms declared in config, rendered as a block, with stored submissions.",
  "license": "MIT",
  "author": "Plumix Contributors",
  "homepage": "https://github.com/withplumix/plumix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withplumix/plumix.git",
    "directory": "packages/plugins/forms"
  },
  "bugs": {
    "url": "https://github.com/withplumix/plumix/issues"
  },
  "keywords": [
    "plumix",
    "plugin",
    "forms",
    "submissions"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "default": "./dist/hooks.js"
    },
    "./fields": {
      "types": "./dist/fields.d.ts",
      "default": "./dist/fields.js"
    },
    "./schema": {
      "types": "./dist/db/schema.d.ts",
      "default": "./dist/db/schema.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "locales/*.mjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "attw": "attw --pack . --profile esm-only",
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules playwright-report test-results",
    "format": "prettier --check . --ignore-path ../../../.gitignore --ignore-path .prettierignore",
    "i18n:extract": "lingui extract",
    "i18n:compile": "plumix-compile-catalogs",
    "i18n:check": "plumix i18n verify",
    "lint": "eslint",
    "publint": "publint",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "drizzle-orm": "catalog:drizzle",
    "valibot": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "catalog:tanstack",
    "plumix": "workspace:>=0.1.0 <1.0.0",
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@axe-core/playwright": "catalog:",
    "@libsql/client": "catalog:",
    "@lingui/cli": "catalog:lingui",
    "@orpc/server": "catalog:orpc",
    "@playwright/test": "catalog:",
    "@plumix/eslint-config": "workspace:*",
    "@plumix/lingui-config": "workspace:*",
    "@plumix/plugin-pages": "workspace:*",
    "@plumix/prettier-config": "workspace:*",
    "@plumix/runtime-cloudflare": "workspace:*",
    "@plumix/typescript-config": "workspace:*",
    "@plumix/vitest-config": "workspace:*",
    "@tanstack/react-query": "catalog:tanstack",
    "@testing-library/jest-dom": "catalog:testing-library",
    "@testing-library/react": "catalog:testing-library",
    "@testing-library/user-event": "catalog:testing-library",
    "@types/node": "catalog:",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitest/coverage-v8": "catalog:vitest",
    "eslint": "catalog:",
    "fishery": "catalog:",
    "jsdom": "catalog:",
    "plumix": "workspace:*",
    "prettier": "catalog:",
    "publint": "catalog:",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "typescript": "catalog:",
    "vitest": "catalog:vitest"
  },
  "prettier": "@plumix/prettier-config",
  "plumix": {
    "scaffold": {
      "kind": "plugin",
      "id": "forms",
      "label": "Forms",
      "description": "Forms declared in config, placed as a block, with stored submissions",
      "category": "engagement",
      "registration": "forms()",
      "imports": [
        "import { forms } from \"@plumix/plugin-forms\";"
      ]
    }
  }
}
