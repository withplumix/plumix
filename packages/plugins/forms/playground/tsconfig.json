{
  "extends": "@plumix/typescript-config/base.json",
  "compilerOptions": {
    "types": ["node", "@cloudflare/workers-types"],
    "jsx": "react-jsx",
    // The plugin source reached through the path alias below includes
    // the form island, which is browser code — see the same line in
    // packages/plugins/media/playground/tsconfig.json.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // Resolve workspace packages from `src/` (not `dist/`) so the
    // playground typechecks against live source. See the comment in
    // packages/plugins/media/playground/tsconfig.json for the rationale.
    "paths": {
      "plumix": ["../../../plumix/src/index.ts"],
      "plumix/blocks/renderer": ["../../../plumix/src/blocks/renderer.ts"],
      "plumix/fields": ["../../../plumix/src/fields/index.ts"],
      "@plumix/plugin-forms": ["../src/index.ts"],
      "@plumix/plugin-pages": ["../../pages/src/index.ts"],
      "@plumix/runtime-cloudflare": [
        "../../../runtimes/cloudflare/src/index.ts"
      ]
    }
  },
  "include": ["plumix.config.ts", "theme.ts", ".plumix"]
}
