{
  "name": "@plumix/plugin-feeds-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Plumix consumer that wires @plumix/plugin-feeds over @plumix/plugin-blog — for manual dogfooding of the feed endpoints",
  "license": "MIT",
  "scripts": {
    "build": "plumix build",
    "clean": "git clean -xdf .plumix .wrangler dist node_modules",
    "dev": "plumix dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@plumix/plugin-blog": "workspace:*",
    "@plumix/plugin-feeds": "workspace:*",
    "@plumix/runtime-cloudflare": "workspace:*",
    "plumix": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:cloudflare",
    "@plumix/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:cloudflare"
  }
}
