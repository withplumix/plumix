{
  "name": "@plumix/plugin-og",
  "version": "0.1.0",
  "type": "module",
  "description": "OG card plugin for Plumix — renders and serves social cards at the edge",
  "license": "MIT",
  "author": "Plumix Contributors",
  "homepage": "https://github.com/withplumix/plumix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withplumix/plumix.git",
    "directory": "packages/plugins/og"
  },
  "bugs": {
    "url": "https://github.com/withplumix/plumix/issues"
  },
  "keywords": [
    "plumix",
    "plugin",
    "og",
    "open-graph",
    "social-card"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./takumi": {
      "types": "./dist/takumi.d.ts",
      "default": "./dist/takumi.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "locales/*.mjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "attw": "attw --pack . --profile esm-only",
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules e2e/playwright-report e2e/test-results",
    "format": "prettier --check . --ignore-path ../../../.gitignore --ignore-path .prettierignore",
    "i18n:check": "plumix i18n verify",
    "i18n:compile": "plumix-compile-catalogs",
    "i18n:extract": "lingui extract",
    "lint": "eslint",
    "publint": "publint",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@takumi-rs/wasm": "^2.12.0",
    "valibot": "catalog:"
  },
  "peerDependencies": {
    "@plumix/plugin-seo": "workspace:>=0.1.0 <1.0.0",
    "@tanstack/react-query": "catalog:tanstack",
    "@tanstack/react-router": "catalog:tanstack",
    "plumix": "workspace:>=0.1.0 <1.0.0",
    "react": "catalog:react"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@lingui/cli": "catalog:lingui",
    "@playwright/test": "catalog:",
    "@plumix/eslint-config": "workspace:*",
    "@plumix/lingui-config": "workspace:*",
    "@plumix/plugin-blog": "workspace:*",
    "@plumix/plugin-seo": "workspace:*",
    "@plumix/prettier-config": "workspace:*",
    "@plumix/runtime-cloudflare": "workspace:*",
    "@plumix/typescript-config": "workspace:*",
    "@plumix/vitest-config": "workspace:*",
    "@tanstack/react-query": "catalog:tanstack",
    "@tanstack/react-router": "catalog:tanstack",
    "@testing-library/jest-dom": "catalog:testing-library",
    "@testing-library/react": "catalog:testing-library",
    "@types/node": "catalog:",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitest/coverage-v8": "catalog:vitest",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "plumix": "workspace:*",
    "prettier": "catalog:",
    "publint": "catalog:",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "typescript": "catalog:",
    "vitest": "catalog:vitest"
  },
  "prettier": "@plumix/prettier-config",
  "plumix": {
    "scaffold": {
      "kind": "plugin",
      "id": "og",
      "label": "OG cards",
      "description": "Generated social cards, rendered and served at the edge",
      "category": "content",
      "registration": "og()",
      "imports": [
        "import { og } from \"@plumix/plugin-og\";"
      ],
      "requires": [
        "storage"
      ]
    }
  }
}
