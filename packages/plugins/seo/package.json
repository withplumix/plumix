{
  "name": "@plumix/plugin-seo",
  "version": "0.0.0",
  "type": "module",
  "description": "SEO plugin for Plumix — head meta, Open Graph, structured data, robots.txt and the sitemap",
  "license": "MIT",
  "author": "Plumix Contributors",
  "homepage": "https://github.com/withplumix/plumix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withplumix/plumix.git",
    "directory": "packages/plugins/seo"
  },
  "bugs": {
    "url": "https://github.com/withplumix/plumix/issues"
  },
  "keywords": [
    "plumix",
    "plugin",
    "seo",
    "open-graph",
    "meta-tags",
    "sitemap",
    "robots-txt",
    "json-ld",
    "structured-data"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "locales/*.mjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "attw": "attw --pack . --profile esm-only",
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../../.gitignore --ignore-path .prettierignore",
    "i18n:check": "plumix i18n verify",
    "i18n:compile": "plumix-compile-catalogs",
    "i18n:extract": "lingui extract",
    "lint": "eslint",
    "publint": "publint",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "valibot": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "catalog:tanstack",
    "@tanstack/react-router": "catalog:tanstack",
    "plumix": "workspace:>=0.1.0 <1.0.0",
    "react": "catalog:react"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@lingui/cli": "catalog:lingui",
    "@playwright/test": "catalog:",
    "@plumix/eslint-config": "workspace:*",
    "@plumix/lingui-config": "workspace:*",
    "@plumix/plugin-blog": "workspace:*",
    "@plumix/prettier-config": "workspace:*",
    "@plumix/runtime-cloudflare": "workspace:*",
    "@plumix/typescript-config": "workspace:*",
    "@plumix/vitest-config": "workspace:*",
    "@tanstack/react-query": "catalog:tanstack",
    "@tanstack/react-router": "catalog:tanstack",
    "@testing-library/jest-dom": "catalog:testing-library",
    "@testing-library/react": "catalog:testing-library",
    "@types/node": "catalog:",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitest/coverage-v8": "catalog:vitest",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "plumix": "workspace:*",
    "prettier": "catalog:",
    "publint": "catalog:",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "typescript": "catalog:",
    "vitest": "catalog:vitest"
  },
  "prettier": "@plumix/prettier-config",
  "plumix": {
    "scaffold": {
      "kind": "plugin",
      "id": "seo",
      "label": "SEO",
      "description": "Head meta, Open Graph, structured data, robots.txt and the sitemap",
      "category": "content",
      "recommended": true,
      "registration": "seo()",
      "imports": [
        "import { seo } from \"@plumix/plugin-seo\";"
      ]
    }
  }
}
