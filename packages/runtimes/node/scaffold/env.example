# Copy to `.env` for local values. `plumix dev` applies it and picks up edits,
# and the built server loads it from the directory it starts in. A variable
# the environment already sets always wins over this file, so a platform's
# injected secrets are never overridden. Do not bake `.env` into an image.
#
# Where the server listens.
PORT=3000
HOST=0.0.0.0
