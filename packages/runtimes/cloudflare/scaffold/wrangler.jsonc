{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "__PROJECT_NAME__",
  "main": ".plumix/worker.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__PROJECT_NAME__",
      // A placeholder so `plumix dev` runs against local D1 out of the box.
      // Run `wrangler d1 create __PROJECT_NAME__` and paste the returned
      // database_id here before deploying — the remote deploy needs the real
      // one.
      "database_id": "local-development-only",
    },
  ],
  "assets": {
    "directory": ".plumix/public",
    "binding": "ASSETS",
    "not_found_handling": "none",
  },
  // Fires plumix's scheduled tasks. `0 3 * * *` matches the core
  // session-cleanup task (daily); `*/5 * * * *` matches publish-scheduled
  // (publishes due future-dated entries within 5 minutes).
  "triggers": {
    "crons": ["0 3 * * *", "*/5 * * * *"],
  },
  // Workers Logs keeps request errors, console output and exceptions; without
  // it a deployed Worker records nothing. Lower `head_sampling_rate` (0-1) on
  // a busy site to log a share of requests.
  "observability": { "enabled": true },
  // Workers Caching serves the anonymous public page without running the
  // Worker. The `cdn` provider purges it on publish; it stays inert, caching
  // nothing, until CF_ZONE_ID and CF_CACHE_PURGE_TOKEN are set.
  "cache": { "enabled": true },
}
