{
  "name": "@plumix/runtime-bun",
  "version": "0.1.0",
  "type": "module",
  "description": "Run a Plumix site on Bun.",
  "license": "MIT",
  "author": "Plumix Contributors",
  "homepage": "https://docs.plumix.dev/deployment/bun/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withplumix/plumix.git",
    "directory": "packages/runtimes/bun"
  },
  "bugs": {
    "url": "https://github.com/withplumix/plumix/issues"
  },
  "keywords": [
    "plumix",
    "bun",
    "runtime",
    "sqlite"
  ],
  "sideEffects": false,
  "engines": {
    "bun": ">=1.4.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./commands": {
      "types": "./dist/commands/index.d.ts",
      "default": "./dist/commands/index.js"
    }
  },
  "files": [
    "dist",
    "scaffold",
    "README.md",
    "LICENSE"
  ],
  "plumix": {
    "scaffold": {
      "kind": "runtime",
      "id": "bun",
      "label": "Bun",
      "description": "A Bun process with bun:sqlite and uploads on disk",
      "imports": [
        "import { bun, bunSqlite } from \"@plumix/runtime-bun\";"
      ],
      "configSlots": {
        "runtime": "bun()",
        "database": "bunSqlite({ path: \"data/site.sqlite\" })"
      },
      "authOrigin": "rpId: \"localhost\", origin: \"http://localhost:3000\"",
      "authOriginComment": "Passkeys are bound to the origin: change both to the host you deploy on.",
      "deps": {
        "@plumix/runtime-bun": "workspace:*"
      },
      "devDeps": {
        "@types/bun": "1.4.2"
      },
      "packageManager": "bun",
      "scripts": {
        "build": "bun --bun plumix build",
        "dev": "bun --bun plumix dev",
        "migrate:apply": "bun --bun plumix migrate apply"
      },
      "cli": "bun --bun plumix",
      "secretsFile": ".env",
      "gitignore": [
        "data"
      ],
      "types": [
        "bun"
      ],
      "readme": "scaffold/README-deploy.md",
      "files": {
        ".env.example": "scaffold/env.example",
        "bunfig.toml": "scaffold/bunfig.toml"
      },
      "capabilities": {
        "storage": {
          "imports": [
            "import { diskStorage } from \"@plumix/runtime-bun\";"
          ],
          "configSlots": {
            "storage": "diskStorage({ dir: \"data/media\" })"
          }
        },
        "imageDelivery": {
          "imports": [
            "import { images } from \"@plumix/runtime-bun\";"
          ],
          "configSlots": {
            "imageDelivery": "images()"
          }
        }
      }
    },
    "e2e": {
      "start": "bun dist/server/worker.js",
      "cli": "bun --bun node_modules/plumix/bin/plumix.mjs",
      "wipe": [
        "data"
      ],
      "database": {
        "glob": "data/*.sqlite"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "attw": "attw --pack . --profile esm-only",
    "build": "tsc -p tsconfig.build.json && plumix-check-declarations",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore",
    "lint": "eslint",
    "publint": "publint",
    "test:unit": "bun --bun ./node_modules/vitest/vitest.mjs run",
    "test:build": "vitest run --config vitest.build.config.ts",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "vite": "catalog:vite"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:drizzle",
    "plumix": "workspace:>=0.24.0 <1.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@plumix/eslint-config": "workspace:*",
    "@plumix/prettier-config": "workspace:*",
    "@plumix/typescript-config": "workspace:*",
    "@plumix/vitest-config": "workspace:*",
    "@types/bun": "1.4.2",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "plumix": "workspace:*",
    "prettier": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:vitest"
  },
  "prettier": "@plumix/prettier-config"
}
