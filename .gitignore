.output/

# worker-driven plugin e2e: storageState.json + e2e-fixtures.json are
# written by globalSetup at the package root; playwright traces / reports
# land in test-results/ + playwright-report/ (already covered above).
storageState.json
e2e-fixtures.json

# plumix generated
.plumix/

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Internal planning and reference docs (not committed)
PLAN.md
.claude/*
!.claude/settings.json
!.claude/skills/

# Compiled lingui catalogs — generated by each package's `i18n:compile`
# (`plumix i18n compile`, or the same compile through core's internal bin
# for the packages `plumix` depends on), never committed. Source of truth is the sibling `.po` files.
# `**/` because that is how knip reads the `./locales/*` export targets that
# point at these: a subpath `*` may cross a `/`, and knip treats a gitignored
# target as build output rather than a missing entry.
packages/*/locales/**/*.mjs
packages/*/locales/**/*.d.mts
packages/plugins/*/locales/**/*.mjs
packages/plugins/*/locales/**/*.d.mts

# Scaffold registry snapshot, written at `prepack` by
# `scripts/build-snapshot.mjs`. Ships in the tarball (it is in `files`),
# never committed.
packages/create-plumix-app/registry.json
