{
  "name": "root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^24.15.0",
    "pnpm": "^10.33.0"
  },
  "scripts": {
    "attw": "turbo run attw",
    "build": "turbo run build",
    "check-no-major": "node .github/scripts/check-no-major.mjs",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "commitlint": "commitlint",
    "dev": "turbo watch dev --continue",
    "docs:screenshots": "turbo run docs:screenshots",
    "format": "turbo run format format:root --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format format:root --continue -- --write --cache --cache-location .cache/.prettiercache",
    "format:root": "prettier --check \"*.{json,md,ts,yaml,yml}\" \".sandcastle/*.ts\" \".sandcastle/lib/*.ts\" \".changeset/**/*.{json,md}\" \".github/**/*.{yml,yaml,md,mjs,json}\" \".vscode/**/*.json\" \"docs/**/*.md\" --ignore-path .gitignore --ignore-path .prettierignore",
    "i18n:check": "turbo run i18n:check",
    "knip": "knip",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "migrations:check": "node .github/scripts/migrations-check.mjs",
    "postinstall": "sherif",
    "publint": "turbo run publint",
    "release": "pnpm run build && changeset publish",
    "smoke": "node .github/scripts/smoke.mjs",
    "test": "turbo run test:unit test:build",
    "test:unit": "turbo run test:unit --concurrency=2",
    "test:build": "turbo run test:build",
    "test:e2e": "turbo run test:e2e --concurrency=4",
    "typecheck": "turbo run typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/config-pnpm-scopes": "^21.2.2",
    "@commitlint/types": "^21.2.3",
    "@plumix/prettier-config": "workspace:*",
    "@types/node": "catalog:",
    "knip": "^6.32.2",
    "pkg-pr-new": "^0.0.88",
    "prettier": "catalog:",
    "sherif": "^1.13.0",
    "turbo": "^2.11.2"
  },
  "pnpm": {
    "overrides": {
      "@types/node@>=25": "$@types/node",
      "esbuild@<0.25.0": ">=0.25.0",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "brace-expansion@<1.1.21": ">=1.1.21 <2",
      "brace-expansion@>=4.0.0 <5.0.12": ">=5.0.12 <6",
      "undici@>=7.0.0 <7.29.1": ">=7.29.1 <8",
      "undici@>=8.0.0 <8.10.2": ">=8.10.2 <9",
      "js-yaml@>=3.0.0 <3.15.1": ">=3.15.1 <4",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2 <5",
      "postcss@<8.5.23": ">=8.5.23",
      "fast-uri@>=3.0.0 <3.1.7": ">=3.1.7 <4",
      "hono@<4.13.5": ">=4.13.5 <5",
      "@hono/node-server@<1.19.15": ">=1.19.15 <2",
      "body-parser@<2.3.0": ">=2.3.0",
      "qs@<6.16.0": ">=6.16.0 <7",
      "sharp@<0.35.5": ">=0.35.5 <0.36",
      "nanoid@<3.3.17": ">=3.3.17 <4",
      "ip-address@<10.5.1": ">=10.5.1 <11",
      "moment@>=2.29.2 <2.31.0": ">=2.31.0 <3",
      "devalue@<5.9.3": ">=5.9.3 <6",
      "shell-quote@>=1.8.4 <1.11.0": ">=1.11.0 <2",
      "seroval@<1.6.3": ">=1.6.3 <2",
      "proxy-addr@<2.0.8": ">=2.0.8 <3",
      "postcss-selector-parser@<7.1.6": ">=7.1.6 <8",
      "source-map-js@<1.2.2": ">=1.2.2 <2",
      "smol-toml@<1.9.0": ">=1.9.0 <2",
      "handlebars@<4.7.10": ">=4.7.10 <5"
    }
  },
  "prettier": "@plumix/prettier-config"
}
