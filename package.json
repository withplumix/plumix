{
  "name": "root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^24.15.0",
    "pnpm": "^10.33.0"
  },
  "scripts": {
    "attw": "turbo run attw",
    "build": "turbo run build",
    "check-no-major": "node .github/scripts/check-no-major.mjs",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "commitlint": "commitlint",
    "dev": "turbo watch dev --continue",
    "docs:screenshots": "turbo run docs:screenshots",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "i18n:check": "turbo run i18n:check",
    "i18n:ratchet:check": "turbo run i18n:ratchet:check",
    "knip": "knip",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "postinstall": "pnpm dlx sherif@latest",
    "publint": "turbo run publint",
    "release": "pnpm run build && changeset publish",
    "smoke": "node .github/scripts/smoke.mjs",
    "test": "turbo run test:unit test:build",
    "test:unit": "turbo run test:unit",
    "test:build": "turbo run test:build",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/config-pnpm-scopes": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@types/node": "catalog:",
    "knip": "^6.24.0",
    "pkg-pr-new": "^0.0.75",
    "turbo": "^2.10.8"
  },
  "pnpm": {
    "overrides": {
      "@types/node@>=25": "$@types/node",
      "esbuild@<0.25.0": ">=0.25.0",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "brace-expansion@<1.1.18": ">=1.1.18 <2",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "undici@>=7.0.0 <7.29.0": ">=7.29.0 <8",
      "js-yaml@>=3.0.0 <3.15.1": ">=3.15.1 <4",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1 <5",
      "postcss@<8.5.23": ">=8.5.23",
      "fast-uri@>=3.0.0 <3.1.5": ">=3.1.5 <4",
      "hono@<4.12.34": ">=4.12.34",
      "@hono/node-server@<1.19.15": ">=1.19.15 <2",
      "body-parser@<2.3.0": ">=2.3.0",
      "sharp@<0.35.0": ">=0.35.0",
      "nanoid@<3.3.17": ">=3.3.17 <4",
      "ip-address@<10.3.1": ">=10.3.1 <11"
    }
  }
}
