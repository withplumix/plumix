{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "topo": {
      // A synthetic ordering node: nothing runs it, but `lint` and `typecheck`
      // depend on `^topo` to reach upstream packages that have no `build`.
      // Its default inputs are every file in the package, so one edited unit
      // test in `@plumix/core` reached the hash of every dependent's lint and
      // typecheck — 35 tasks for a file no compiler reads. Same exclusions as
      // `build` below; keep them in step.
      "dependsOn": ["^topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!e2e/**",
        "!screenshots/**"
      ]
    },
    "i18n:compile": {
      "inputs": ["locales/*.po"],
      "outputs": ["locales/*.mjs", "locales/*.d.mts"]
    },
    "build": {
      "dependsOn": ["^build", "i18n:compile"],
      // Every `tsconfig.build.json` already excludes these, so the compiler
      // never read them — turbo's hash just did not say so, and the difference
      // cascaded through `^build` into every dependent. Verified: narrowing
      // this leaves `dist/` byte-identical.
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!e2e/**",
        "!screenshots/**"
      ],
      "outputs": [".cache/build.tsbuildinfo", "dist/**"],
      "env": [
        "WORKERS_CI",
        "WORKERS_CI_BRANCH",
        "PLUMIX_DEV",
        "PLUMIX_DEV_ALLOW_REMOTE",
        "PLUMIX_EDITOR",
        "PLUMIX_EDITOR_PATH_MAP",
        "PLUMIX_FORWARD_ERRORS"
      ]
    },
    "dev": {
      "dependsOn": ["i18n:compile"],
      "cache": false,
      "persistent": true
    },
    "format": {
      // The ignore paths and the shared config every `format` script reads
      // live at the repo root, outside `$TURBO_DEFAULT$`. Without these,
      // dropping an entry from `.prettierignore` — or changing `importOrder` —
      // serves 26 cached passes for the one edit that moves the verdict.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/.prettierignore",
        "$TURBO_ROOT$/tooling/prettier/index.js"
      ],
      "outputs": [".cache/.prettiercache"],
      "outputLogs": "new-only"
    },
    // Root-level files sit in no workspace, so the per-package `format` tasks
    // never saw them. Globs are extension-explicit on purpose: `.github/` holds
    // CODEOWNERS, and the root holds LICENSE and `*.toml`, none of which
    // Prettier can parse.
    "//#format:root": {
      "inputs": [
        "*.{json,md,ts,yaml,yml}",
        ".changeset/**",
        ".github/**",
        ".vscode/**",
        "docs/**",
        ".gitignore",
        ".prettierignore",
        "tooling/prettier/index.js"
      ],
      "outputs": [".cache/.prettiercache"],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": ["^topo", "^build", "i18n:compile"],
      "outputs": [".cache/.eslintcache"]
    },
    "typecheck": {
      "dependsOn": ["^topo", "^build", "i18n:compile"],
      "outputs": [".cache/typecheck.tsbuildinfo"]
    },
    "test:unit": {
      // Low-level tests: resolve workspace imports to source and stub
      // name-imported i18n catalogs (see tooling/vitest/source-resolver.ts), so
      // they depend on nothing generated — no build, no i18n:compile.
      //
      // `^topo` and not `[]`, because resolving to source is exactly what makes
      // an upstream package's source part of what these tests execute. With no
      // edge at all, a package's hash covered only its own files, and turbo
      // served a cached pass for the change that breaks the test: #2086 altered
      // `settings.get` and `@plumix/plugin-seo`'s suite — which caught the
      // regression — replayed from cache and merged red (#2093).
      //
      // `topo` rather than `^build` keeps the intent above: it is the synthetic
      // ordering node, so nothing is built. Its inputs already exclude
      // `*.test.ts`, so editing an upstream test still does not cascade.
      //
      // The root `test:unit` script runs this task set under `--concurrency=2`.
      // Each of the 21 vitest packages sizes its own worker pool to the machine
      // (`maxWorkers` defaults to cores - 1), so turbo's concurrency *is* the
      // oversubscription factor, on any runner: at the default 10 the pools
      // hold ten times the cores' worth of workers, and a test's wall clock
      // becomes its CPU time times that. Vitest's 5s default is wall clock, so
      // the bar for a timeout was ~140ms of CPU — which is what failed the
      // required Test check on release PR #2132 and forced #2162.
      //
      // A cap and not narrower inputs: a version bump busts every hash through
      // `^topo`, but so does a one-line edit to core (29 of these 38 tasks,
      // against a release PR's 31), so a cold graph is the normal case and the
      // cap is what makes it survivable. Excluding `package.json` would fix the
      // hashing and reinstate #2093 — verified: with it excluded, editing a
      // package's own `test:unit` command moves no hash at all.
      //
      // 2 and not 1: two pools of `cores - 1` still saturate the runner, so the
      // cap costs no wall clock there, while 1 leaves it idle. Measured cold on
      // a 10-core box, slowest single test: 6607ms at 10, 2287ms at 2, 1237ms
      // at 1.
      "dependsOn": ["^topo"]
    },
    "@plumix/e2e-ports#test:unit": {
      // The guard scans every playwright config in the repo, so its verdict
      // turns on files outside this package. Without these inputs turbo would
      // hash only `tooling/e2e-ports/` and serve a cached pass for exactly the
      // change that introduces a collision — the PR that edits one suite's
      // config and nothing else.
      //
      // A `pkg#task` entry replaces the base definition rather than extending
      // it, so `^topo` has to be repeated here or this one task keeps the
      // no-edge hashing the base moved away from.
      "dependsOn": ["^topo"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/**/playwright.config.ts"]
    },
    "@plumix/blocks#test:unit": {
      // The block-text corpus test asserts against the demo site's seeded
      // content, which lives downstream of this package — `^topo` never reaches
      // it, so without the input turbo replays a green for the seed edit that
      // breaks the test. Same `pkg#task` caveat as above: the entry replaces
      // the base definition, so `^topo` is repeated.
      "dependsOn": ["^topo"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/demo/seed.sql"]
    },
    "test:build": {
      // Tests that need the build graph (`*.build.test.ts`): plumix inspects
      // the artifacts of a real Vite build, and the docs content checks compile
      // samples against the published `.d.ts` files.
      "dependsOn": ["build", "^build"]
    },
    "@plumix-apps/docs#test:build": {
      // Only `^build` — the samples are compiled against the packages' types,
      // and nothing here reads the site's own output. Depending on `build` too
      // would rebuild the whole Starlight site on every content edit, which is
      // exactly when this check runs, and would surface a broken page as an
      // Astro error before the finding this check exists to report.
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      // Cached, like `test:unit`, `test:build` and `docs:screenshots` — which
      // drives this same rig (#1949). With the inputs above, a hit means
      // nothing a suite exercises has moved; a change to core still runs all
      // ten, and a change to one plugin runs that plugin's.
      //
      // The cost, stated plainly: `retries: 2` means a suite that only went
      // green on its third attempt stays green until its inputs change.
      // Caching does not lower that bar, it stops re-rolling identical inputs.
      "dependsOn": ["build", "^build"],
      "passThroughEnv": ["PLUMIX_E2E_PORT_OFFSET"]
    },
    "@plumix/runtime-cloudflare#test:e2e": {
      // The runtime's playground wires the blog and media plugins, which
      // depend on this package — so `^build` cannot reach them without a
      // cycle in the package graph. Name their builds here instead: an
      // ordering edge in the task graph only (#1883 is what a missing one
      // looks like). A `pkg#task` entry replaces the base definition, so the
      // rest is repeated.
      "dependsOn": [
        "build",
        "^build",
        "@plumix/plugin-blog#build",
        "@plumix/plugin-media#build"
      ],
      "passThroughEnv": ["PLUMIX_E2E_PORT_OFFSET"]
    },
    "docs:screenshots": {
      // Same graph as `test:e2e`: the capture drives the built admin through
      // `vite preview`.
      //
      // The images land in `apps/docs`, not here, so the outputs reach across
      // packages. That is safe to cache because the capture renders in a
      // pinned container (see packages/admin/README.md) rather than on
      // whatever machine ran it: a remote-cache hit restores the same bytes a
      // local run would have written. The hit also skips the CI check this
      // task doubles as, which is fine — the hash covers the admin package and
      // everything it is built from, so a hit means nothing that could move a
      // selector changed.
      //
      // The glob owns a directory of its own rather than the shared assets
      // one: turbo restores outputs over whatever is in their way, so a glob
      // across `src/assets` would revert edits to hand-authored images there.
      "dependsOn": ["build", "^build"],
      "outputs": ["../../apps/docs/src/assets/screenshots/**"],
      "passThroughEnv": ["PLUMIX_E2E_PORT_OFFSET"]
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    },
    "publint": {
      // Validates the published tarball, which is `dist/` plus the manifest —
      // no package ships `src/`, so a unit test cannot change the answer.
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!e2e/**",
        "!screenshots/**"
      ]
    },
    "attw": {
      // Same surface as publint above.
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!e2e/**",
        "!screenshots/**"
      ]
    },
    "i18n:check": {
      // Cacheable: a pure comparison of the message ids in source against the
      // active msgids in `locales/*.po`. It was `cache: false` with no reason
      // recorded, which made these nine tasks — and the `plumix#build` they
      // pull — the floor under every commit, including README-only ones.
      // Verified: deleting a msgid from every locale still fails on a warm cache.
      "dependsOn": ["plumix#build"]
    },
    "i18n:ratchet:check": {
      // Re-runs eslint over `STRICT_UNWRAPPED_FILES` with
      // `lingui/no-unlocalized-strings` forced back to error, so a file that
      // has since been wrapped fails until it leaves the denylist.
      //
      // `^topo` is load-bearing, not ordering: the verdict depends on the
      // shared eslint config, which lives in another package. Without it a
      // cached pass would survive a rule change that should have moved it.
      "dependsOn": ["^topo"]
    }
  },
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "npm_lifecycle_event",
    "NO_COLOR",
    "FORCE_COLOR",
    "PLUMIX_VERBOSE"
  ]
}
