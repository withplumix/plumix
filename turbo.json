{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "i18n:compile": {
      "inputs": ["locales/*.po"],
      "outputs": ["locales/*.mjs", "locales/*.d.mts"]
    },
    "build": {
      "dependsOn": ["^build", "i18n:compile"],
      "outputs": [".cache/build.tsbuildinfo", "dist/**"],
      "env": [
        "WORKERS_CI",
        "WORKERS_CI_BRANCH",
        "PLUMIX_DEV",
        "PLUMIX_EDITOR",
        "PLUMIX_EDITOR_PATH_MAP",
        "PLUMIX_FORWARD_ERRORS"
      ]
    },
    "dev": {
      "dependsOn": ["i18n:compile"],
      "cache": false,
      "persistent": true
    },
    "format": {
      "outputs": [".cache/.prettiercache"],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": ["^topo", "^build", "i18n:compile"],
      "outputs": [".cache/.eslintcache"]
    },
    "typecheck": {
      "dependsOn": ["^topo", "^build", "i18n:compile"],
      "outputs": [".cache/typecheck.tsbuildinfo"]
    },
    "test:unit": {
      // Low-level tests: resolve workspace imports to source and stub
      // name-imported i18n catalogs (see tooling/vitest/source-resolver.ts), so
      // they depend on nothing generated — no build, no i18n:compile.
      "dependsOn": []
    },
    "test:build": {
      // Tests that need the build graph (`*.build.test.ts`): plumix inspects
      // the artifacts of a real Vite build, and the docs content checks compile
      // samples against the published `.d.ts` files.
      "dependsOn": ["build", "^build"]
    },
    "@plumix-apps/docs#test:build": {
      // Only `^build` — the samples are compiled against the packages' types,
      // and nothing here reads the site's own output. Depending on `build` too
      // would rebuild the whole Starlight site on every content edit, which is
      // exactly when this check runs, and would surface a broken page as an
      // Astro error before the finding this check exists to report.
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      // Deliberately uncached (#1949). A cache hit is a pass that never ran,
      // and this is the tier where flakes live: `retries: 2` means a suite
      // that only went green on its third attempt would then be replayed as
      // green for as long as nothing under `packages/` changed.
      //
      // The argument for caching was that a docs-only pull request should not
      // pay 4 minutes for it. CI answers that with `--affected` instead, which
      // skips the suites a change cannot reach without claiming they passed.
      // `docs:screenshots` below is cached despite driving the same rig,
      // because it produces an artifact whose bytes are the assertion.
      "dependsOn": ["build", "^build"],
      "cache": false,
      "passThroughEnv": ["PLUMIX_E2E_PORT_OFFSET"]
    },
    "docs:screenshots": {
      // Same graph as `test:e2e`: the capture drives the built admin through
      // `vite preview`.
      //
      // The images land in `apps/docs`, not here, so the outputs reach across
      // packages. That is safe to cache because the capture renders in a
      // pinned container (see packages/admin/README.md) rather than on
      // whatever machine ran it: a remote-cache hit restores the same bytes a
      // local run would have written. The hit also skips the CI check this
      // task doubles as, which is fine — the hash covers the admin package and
      // everything it is built from, so a hit means nothing that could move a
      // selector changed.
      //
      // The glob owns a directory of its own rather than the shared assets
      // one: turbo restores outputs over whatever is in their way, so a glob
      // across `src/assets` would revert edits to hand-authored images there.
      "dependsOn": ["build", "^build"],
      "outputs": ["../../apps/docs/src/assets/screenshots/**"],
      "passThroughEnv": ["PLUMIX_E2E_PORT_OFFSET"]
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    },
    "publint": {
      "dependsOn": ["build"]
    },
    "attw": {
      "dependsOn": ["build"]
    },
    "i18n:check": {
      "dependsOn": ["plumix#build"],
      "cache": false
    },
    "i18n:ratchet:check": {
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "npm_lifecycle_event",
    "NO_COLOR",
    "FORCE_COLOR",
    "PLUMIX_VERBOSE"
  ]
}
