{
  "name": "@plumix-apps/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Plumix documentation site — Astro Starlight (structure in place; content and versioning still ahead)",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "clean": "git clean -xdf .astro dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .gitignore",
    "lint": "astro sync && eslint",
    "test:unit": "vitest run",
    "test:build": "vitest run --config vitest.build.config.ts",
    "typecheck": "astro sync && astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/starlight": ">=0.41.5 <0.41.7",
    "astro": "^7.1.1",
    "starlight-auto-sidebar": "^0.4.0",
    "starlight-links-validator": "^0.25.3",
    "starlight-llms-txt": "^0.11.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "catalog:cloudflare",
    "@plumix/eslint-config": "workspace:*",
    "@plumix/prettier-config": "workspace:*",
    "@plumix/typescript-config": "workspace:*",
    "@plumix/vitest-config": "workspace:*",
    "@types/mdast": "^4.0.4",
    "@types/node": "catalog:",
    "@types/react": "catalog:react",
    "@vitest/coverage-v8": "catalog:vitest",
    "eslint": "catalog:",
    "plumix": "workspace:*",
    "prettier": "catalog:",
    "prettier-plugin-astro": "^0.14.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.3",
    "typescript": "catalog:",
    "unified": "^11.0.5",
    "vitest": "catalog:vitest",
    "wrangler": "catalog:cloudflare",
    "yaml": "^2.8.1"
  }
}
