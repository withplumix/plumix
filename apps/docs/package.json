{
  "name": "@plumix-apps/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Plumix documentation site — Astro Starlight (structure in place; content and versioning still ahead)",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "clean": "git clean -xdf .astro dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "astro sync && eslint",
    "typecheck": "astro sync && astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.6",
    "astro": "^7.3.8",
    "starlight-auto-sidebar": "^0.4.1",
    "starlight-links-validator": "^0.26.0",
    "starlight-llms-txt": "^0.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@plumix/eslint-config": "workspace:*",
    "@plumix/prettier-config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "sharp": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:cloudflare"
  },
  "prettier": "@plumix/prettier-config"
}
