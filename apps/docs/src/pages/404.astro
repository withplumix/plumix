---
// Starlight's own 404 route looks up a `404` entry in the docs collection and
// warns on every build when there is none. An entry there would also build a
// second page at `/404/`, join the autogenerated sidebar and the `llms-full.txt`
// corpus, so the site owns the route instead (`disable404Route` in
// `astro.config.mjs`) and renders what Starlight's fallback did.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
---

<StarlightPage
  frontmatter={{
    title: "404",
    description: "No page lives at this address.",
    tier: "P2",
    template: "splash",
    editUrl: false,
    pagefind: false,
    hero: { tagline: Astro.locals.t("404.text") },
  }}
/>
